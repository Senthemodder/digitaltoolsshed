<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Convert Weeks to Days — Free Online Calculator | UnitCalc</title>
  <meta name="description" content="Instantly convert Weeks (wk) to Days (d). Free, fast, no signup.">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header>
    <div class="container header-inner">
      <a href="index.html" class="logo">UnitCalc</a>
      <button id="themeToggle" class="btn">Toggle Theme</button>
    </div>
  </header>
  
  <div class="container ad-slot-header ad-slot">Leaderboard Ad (728x90)</div>

  <main class="container page-layout">
    <div class="main-content">
      <nav class="breadcrumb">
        <a href="index.html">Home</a> &gt; Time &gt; Weeks to Days
      </nav>

      <h1>Convert Weeks to Days</h1>
      
      <div class="converter-card">
        <div class="input-group">
          <label>Weeks (wk)</label>
          <input type="number" id="fromInput" placeholder="0" />
        </div>
        <div class="equals">=</div>
        <div class="input-group">
          <label>Days (d)</label>
          <input type="number" id="toInput" placeholder="0" />
        </div>
      </div>

      <div class="ad-slot-content ad-slot">In-Content Ad (336x280)</div>

      <div class="formula-section card">
        <h2>Formula</h2>
        
          <p>How to convert Weeks to Days: Multiply by 7.</p>
          <p class="formula">Formula: Days = Weeks &times; 7</p>
        
      </div>

      <div class="table-section card">
        <h2>Quick Reference Table</h2>
        <table>
          <thead>
            <tr>
              <th>Weeks (wk)</th>
              <th>Days (d)</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>1 wk</td><td>7 d</td></tr><tr><td>5 wk</td><td>35 d</td></tr><tr><td>10 wk</td><td>70 d</td></tr><tr><td>25 wk</td><td>175 d</td></tr><tr><td>50 wk</td><td>350 d</td></tr><tr><td>100 wk</td><td>700 d</td></tr><tr><td>500 wk</td><td>3500 d</td></tr><tr><td>1000 wk</td><td>7000 d</td></tr><tr><td>5000 wk</td><td>35000 d</td></tr><tr><td>10000 wk</td><td>70000 d</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <aside class="sidebar">
      <div class="ad-slot-sidebar ad-slot">Sidebar Ad (300x250)</div>
      
      <div class="related-card card">
        <h3>Related Time Conversions</h3>
        <ul>
          <li><a href="hours-to-minutes.html">Hours to Minutes</a></li><li><a href="days-to-hours.html">Days to Hours</a></li>
        </ul>
      </div>
    </aside>
  </main>

  <footer>
    <div class="container">
      <p>&copy; 2026 UnitCalc. Free, fast unit converters.</p>
    </div>
  </footer>

  <script src="app.js"></script>
  <script>
    
        const factor = 7;
        const fromInput = document.getElementById('fromInput');
        const toInput = document.getElementById('toInput');
        
        fromInput.addEventListener('input', (e) => {
          const val = parseFloat(e.target.value);
          if (isNaN(val)) toInput.value = '';
          else toInput.value = parseFloat((val * factor).toFixed(6));
        });
        toInput.addEventListener('input', (e) => {
          const val = parseFloat(e.target.value);
          if (isNaN(val)) fromInput.value = '';
          else fromInput.value = parseFloat((val / factor).toFixed(6));
        });
      
  </script>
</body>
</html>